#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-or-later
# procd wrapper: starts the revert-countdown daemon on boot when a pending
# (unconfirmed) sysupgrade exists. START=15: as early as procd allows, so the
# guard is armed well before network/luci come up. Countdown is measured
# against /proc/uptime (monotonic) — NTP being down cannot break it.
START=15
USE_PROCD=1

start_service() {
	[ -f /etc/sysupgrade-confirm/pending ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/sysupgrade-confirm _daemon
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
