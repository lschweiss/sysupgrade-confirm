config sysupgrade-confirm 'main'
	# seconds after boot before an unconfirmed firmware is reverted
	option deadline '600'
	# auto-confirm when the checks below pass check_consecutive times in a row
	option auto_confirm '0'
	option check_gateway '1'
	option check_wan '0'
	option check_wan_host '1.1.1.1'
	option check_consecutive '3'
	option check_interval '10'
